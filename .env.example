# ==========================================
# CyberLab MTUSI - Database Configuration
# ==========================================
# Uncomment ONE of the following database options:

# --- OPTION 1: SQLite (default, no setup required) ---
# DB_TYPE=sqlite
PRISMA_PROVIDER=sqlite
DATABASE_URL=file:./db/custom.db

# --- OPTION 2: PostgreSQL (requires docker-compose or external server) ---
# DB_TYPE=postgresql
# PRISMA_PROVIDER=postgresql
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cyberlab?schema=public

# --- OPTION 3: MongoDB (requires docker-compose or external server) ---
# DB_TYPE=mongodb
# MONGODB_URI=mongodb://localhost:27017/cyberlab
# MONGODB_DB=cyberlab

# ==========================================
# Port Configuration
# ==========================================
# PORT=3000  # Auto-detected if not set. Set to override.

# ==========================================
# Node Environment
# ==========================================
NODE_ENV=development
