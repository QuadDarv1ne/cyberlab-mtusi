# ==========================================
# CyberLab MTUSI - Environment Configuration
# ==========================================
# All parameters are auto-detected if not set.
# Only uncomment to override defaults.

# ==========================================
# Database (auto-detected from DATABASE_URL pattern)
# ==========================================
# SQLite (default):
# DATABASE_URL=file:./db/custom.db

# PostgreSQL:
# DATABASE_URL=postgresql://user:pass@host:port/dbname?schema=public
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=cyberlab
# POSTGRES_PORT=5432
# POSTGRES_HOST=localhost  # or "cyberlab-postgres" in Docker

# MongoDB:
# MONGODB_URI=mongodb://user:pass@host:port/dbname
# MONGODB_USER=root
# MONGODB_PASSWORD=root
# MONGODB_PORT=27017
# MONGODB_HOST=localhost  # or "cyberlab-mongodb" in Docker

# To force a specific database type regardless of URL:
# DB_TYPE=sqlite
# Options: sqlite, postgresql, mongodb

# Prisma provider (auto-detected, only needed for db:push scripts):
# PRISMA_PROVIDER=sqlite

# ==========================================
# Port (auto-detected: scans from 3000 upward)
# ==========================================
# PORT=3000

# ==========================================
# Logging
# ==========================================
# Set to true to enable error logging in production
LOG_ERRORS=false

# ==========================================
# Node Environment
# ==========================================
NODE_ENV=development

# ==========================================
# NextAuth
# ==========================================
# Generate with: openssl rand -base64 32
# DO NOT use this placeholder in production!
NEXTAUTH_SECRET=<GENERATE_YOUR_OWN_SECRET>
NEXTAUTH_URL=http://localhost:3000

# ==========================================
# Health Check
# ==========================================
# GET /api/health — returns database status and uptime
# No auth required. Returns 200 (ok) or 503 (degraded)