generator client {
  provider = "prisma-client-js"
}

// Provider is set at generate time via PRISMA_PROVIDER env var
// Supported: sqlite (default), postgresql
// MongoDB uses native driver, not Prisma
datasource db {
  provider = env("PRISMA_PROVIDER")
  url      = env("DATABASE_URL")
}

model Student {
  id             String   @id @default(cuid())
  name           String
  group          String
  createdAt      DateTime @default(now())
  progress       LabProgress[]
  flagSubmissions FlagSubmission[]
}

model Lab {
  id             String   @id @default(cuid())
  number         Int      @unique
  title          String
  description    String
  goal           String
  tools          String
  difficulty     String   @default("medium")
  category       String
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  flags          LabFlag[]
  progress       LabProgress[]
  flagSubmissions FlagSubmission[]
}

model LabFlag {
  id       String @id @default(cuid())
  labId    String
  flagKey  String
  flagValue String
  points   Int    @default(10)
  hint     String?
  lab      Lab    @relation(fields: [labId], references: [id], onDelete: Cascade)

  @@index([labId])
}

model LabProgress {
  id         String   @id @default(cuid())
  studentId  String
  labId      String
  status     String   @default("not_started")
  flagsFound Int      @default(0)
  totalFlags Int      @default(0)
  score      Int      @default(0)
  startedAt  DateTime?
  completedAt DateTime?
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lab        Lab      @relation(fields: [labId], references: [id], onDelete: Cascade)

  @@unique([studentId, labId])
}

model FlagSubmission {
  id        String   @id @default(cuid())
  studentId String
  labId     String
  flagKey   String
  flagValue String
  correct   Boolean
  createdAt DateTime @default(now())

  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lab       Lab      @relation(fields: [labId], references: [id], onDelete: Cascade)

  @@unique([studentId, labId, flagKey, correct], name: "unique_correct_flag_per_student")
  @@index([studentId, labId, flagKey])
  @@index([studentId, correct])
}

model Article {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String
  content     String
  author      String
  category    String
  tags        String   // JSON array stored as string
  coverImage  String?
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
