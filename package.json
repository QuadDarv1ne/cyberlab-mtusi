{
  "name": "nextjs_tailwind_shadcn_ts",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev-server.js 2>&1 | tee dev.log",
    "dev:sqlite": "cross-env DB_TYPE=sqlite node scripts/dev-server.js 2>&1 | tee dev.log",
    "dev:postgres": "cross-env DB_TYPE=postgresql node scripts/dev-server.js 2>&1 | tee dev.log",
    "dev:mongo": "cross-env DB_TYPE=mongodb node scripts/dev-server.js 2>&1 | tee dev.log",
    "build": "next build && shx cp -r .next/static .next/standalone/.next/ && shx cp -r public .next/standalone/",
    "start": "cross-env NODE_ENV=production node .next/standalone/server.js 2>&1 | tee server.log",
    "start:auto": "node scripts/start-server.js 2>&1 | tee server.log",
    "lint": "eslint .",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "db:seed": "tsx prisma/seed.ts",
    "db:push:sqlite": "cross-env PRISMA_PROVIDER=sqlite DATABASE_URL=file:./db/custom.db prisma db push",
    "db:push:postgres": "cross-env PRISMA_PROVIDER=postgresql DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cyberlab?schema=public prisma db push",
    "db:migrate:pg": "cross-env PRISMA_PROVIDER=postgresql DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cyberlab?schema=public prisma migrate dev",
    "db:seed:mongo": "tsx prisma/seed-mongodb.ts",
    "db:reset:mongo": "tsx prisma/seed-mongodb.ts",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:reset": "docker-compose down -v"
  },
  "dependencies": {
    "2": "^3.0.0",
    "@prisma/client": "^6.11.1",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toast": "^1.2.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.525.0",
    "mongodb": "^6.12.0",
    "next": "^16.1.1",
    "prisma": "^6.11.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.4",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.0.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "25.9.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.0.0",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "shx": "^0.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.19.3",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5"
  }
}
